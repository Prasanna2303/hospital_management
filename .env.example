# Copy to .env (never commit .env). All values below are development-only placeholders.

# Backend
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5433/hospital
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/hospital_test
# Required (and must not be the default) when NODE_ENV=production
JWT_SECRET=dev-only-change-me
CORS_ORIGIN=http://localhost:5173
CLINIC_TZ=Asia/Kolkata
MAX_BOOKING_DAYS=90
AUTH_RATE_LIMIT_MAX=30

# Frontend (client/.env, optional)
VITE_API_URL=http://localhost:4000
VITE_CLINIC_TZ=Asia/Kolkata
